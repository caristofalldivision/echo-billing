# Direct (non-pooled) Postgres connection — RADIUS auth is latency-sensitive
# and long-lived, so this bypasses Supabase's pgbouncer pool.
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres

RADIUS_AUTH_PORT=1812
RADIUS_ACCT_PORT=1813
RADIUS_SHARED_SECRET=change-me

# WireGuard concentrator
WIREGUARD_INTERFACE=wg0
WIREGUARD_LISTEN_PORT=51820
WIREGUARD_SERVER_PRIVATE_KEY=
WIREGUARD_SERVER_ADDRESS=10.77.0.1/16
WIREGUARD_PEER_SYNC_INTERVAL_MS=30000
